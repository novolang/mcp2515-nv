// mcp2515_tests — the driver over a double of the part: a register file
// behind the SPI instruction set of Microchip's data sheet (MCP2515,
// DS20001801J, section 12), so every transaction of every entry point is
// checked on the host.
//
// The double follows the data sheet where the driver depends on it:
//
//   - the instructions RESET, READ, WRITE, BIT MODIFY, LOAD TX BUFFER, RTS,
//     READ STATUS, RX STATUS and READ RX BUFFER, with the address advancing
//     through a transaction, and READ RX BUFFER clearing its RXnIF flag when
//     chip select is raised;
//   - CNF1 to CNF3, the masks and the filters are writable in Configuration
//     mode only, and the masks and filters read zero in every other mode;
//   - BIT MODIFY forces the mask to 0xFF on a register that does not take it;
//   - a mode request is applied after a number of reads of CANSTAT, to run
//     the wait for the bus; CANSTAT reads at every address ending in 0xE and
//     CANCTRL at every address ending in 0xF;
//   - the transmit buffers send the highest priority first and the highest
//     number first among equals; a frame is looped into the receive buffers
//     in Loopback mode;
//   - a received frame goes through the masks and filters (RXM 00) or not
//     (RXM 11), into RXB0 and, by rollover, into RXB1, and a frame with no
//     free buffer sets the overflow flag.
//
// The log records what crossed the bus, as integers: -100 starts an SPI
// transaction and the bytes the controller clocked out follow; -200 and a
// time is a wait; -300, a pin and a level is a pin driven; -301, a pin and
// a direction is a pin mode; -302, a clock and a mode is the bus
// initialised.
//
// The double can fail the n-th transaction at the link (`st` 23), ignore the
// first resets (`st` 15), delay a mode change by reads of CANSTAT (`st` 3),
// or be absent (`st` 1).

use std.test
use embedded_hal.{ BoardSpi, BoardGpio, SpiBus, GpioOut, Timer, CanBus, CanBusFrame }
use dev_bus.{ DeviceWiring, DevBytes }
use mcp2515
use mcp2515.{ Mcp2515, MccLink, Mcp2515Config }

// ── The double ───────────────────────────────────────────────────────
//
// `st` keys: 1 is 1 when a part is there; 2 the mode, 0 to 4; 3 the reads
// of CANSTAT before a mode request takes effect; 4 the mode requested and
// 5 the reads left before it does, -1 for none; 6 is 1 inside a
// transaction; 8 the instruction; 9 the address pointer; 10 the byte
// index; 11 and 12 the BIT MODIFY address and mask; 13 the receive buffer
// being read; 14 the resets seen; 15 the resets to ignore; 19 the INT pin
// level; 22 is 1 to keep TXREQ set on an abort; 23 the transaction at the
// link to fail, counting from 1; 24 the transactions seen; 25 is 1 to ignore
// writes to the bit timing and 26 to ignore writes to masks and filters; 30 and 31 the
// filter that matched RXB0 and RXB1; 40 the frames sent; 41 the frames
// received; 42 the frames lost.

struct Chip
    regs: HashMap<Int, Int>
    st: HashMap<Int, Int>
    log: HashMap<Int, Int>
    sent: HashMap<Int, Int>

fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

fn log_push(c: Chip, v: Int)
    let n = at(c.log, -1)
    c.log.insert(n, v)
    c.log.insert(-1, n + 1)

fn log_clear(c: Chip)
    c.log.clear()

fn reset_regs(c: Chip)
    c.regs.clear()
    c.st.insert(2, 4)
    c.st.insert(4, -1)
    c.regs.insert(0x0F, 0x87)
    c.regs.insert(0x60, 0)
    c.regs.insert(0x70, 0)

fn chip() -> Chip
    let c = Chip { regs: HashMap.new(), st: HashMap.new(), log: HashMap.new(), sent: HashMap.new() }
    c.st.insert(1, 1)
    c.st.insert(19, 1)
    reset_regs(c)
    c

// A part that has been opened: Normal mode.
fn running() -> Chip
    let c = chip()
    c.st.insert(2, 0)
    c.regs.insert(0x0F, 0x07)
    c

// The addresses that BIT MODIFY works on (Table 11-1).
fn modifiable(a: Int) -> Bool
    if (a & 0x0F) == 0x0F
        return true
    if a == 0x0C or a == 0x0D or a == 0x28 or a == 0x29 or a == 0x2A or a == 0x2B or a == 0x2C or a == 0x2D
        return true
    a == 0x30 or a == 0x40 or a == 0x50 or a == 0x60 or a == 0x70

// A register as the part answers a read.
fn chip_read(c: Chip, a: Int) -> Int
    if (a & 0x0F) == 0x0E
        let want = at(c.st, 4)
        if want >= 0
            let left = at(c.st, 5)
            if left <= 0
                c.st.insert(2, want)
                c.st.insert(4, -1)
            else
                c.st.insert(5, left - 1)
        return at(c.st, 2) << 5
    if a < 0x28 and (a & 0x0F) < 0x0C and at(c.st, 2) != 4
        // Filters and masks read zero outside Configuration mode.
        return 0
    at(c.regs, a)

// Whether a register takes a write now.
fn writable(c: Chip, a: Int) -> Bool
    if a < 0x0C or (a >= 0x10 and a < 0x1C) or (a >= 0x20 and a <= 0x2A)
        if at(c.st, 26) == 1 and a < 0x28
            return false
        if at(c.st, 25) == 1 and a >= 0x28
            // A part that ignores the bit timing, to show the read-back.
            return false
        if at(c.st, 25) == 2 and a == 0x2A
            return false
        return at(c.st, 2) == 4
    true

// A write: CANCTRL requests a mode and may abort, the other registers
// store.
fn chip_write(c: Chip, a: Int, v: Int)
    if not writable(c, a)
        return
    if (a & 0x0F) == 0x0E
        return
    c.regs.insert(a, v & 0xFF)
    if (a & 0x0F) == 0x0F
        let want = (v >> 5) & 7
        c.st.insert(4, want)
        c.st.insert(5, at(c.st, 3))
        if at(c.st, 3) == 0
            c.st.insert(2, want)
            c.st.insert(4, -1)
        if (v & 0x10) != 0 and at(c.st, 22) == 0
            for b in 0..3
                c.regs.insert(0x30 + 0x10 * b, at(c.regs, 0x30 + 0x10 * b) & 0xF7)

// BIT MODIFY.
fn chip_modify(c: Chip, a: Int, mask: Int, data: Int)
    var m = mask
    if not modifiable(a)
        m = 0xFF
    let old = at(c.regs, a)
    chip_write(c, a, (old & (0xFF ^ m)) | (data & m))

// The frame of the buffer at `base` (0x31 for TXB0): the identifier, the
// flags and the data packed as the CanBusFrame packs them.
fn frame_at(c: Chip, base: Int) -> Int
    at(c.regs, base)

fn ext_of(c: Chip, base: Int) -> Bool
    (at(c.regs, base + 1) & 0x08) != 0

fn id_of(c: Chip, base: Int) -> Int
    mcp2515.regs_id(at(c.regs, base), at(c.regs, base + 1), at(c.regs, base + 2), at(c.regs, base + 3))

fn len_of(c: Chip, base: Int) -> Int
    var n = at(c.regs, base + 4) & 0x0F
    if n > 8
        n = 8
    n

fn data_of(c: Chip, base: Int) -> Int
    var d = 0
    for i in 0..len_of(c, base)
        d = d | (at(c.regs, base + 5 + i) << (8 * i))
    d

// The data byte `i` of a packed data word.
fn byte_of(d: Int, i: Int) -> Int
    (d >> (8 * i)) & 0xFF

// The identifier a filter or a mask register group holds.
fn group_id(c: Chip, a: Int, ext: Bool) -> Int
    if ext
        return (at(c.regs, a) << 21) | (((at(c.regs, a + 1) >> 5) & 7) << 18) | ((at(c.regs, a + 1) & 3) << 16) | (at(c.regs, a + 2) << 8) | at(c.regs, a + 3)
    (at(c.regs, a) << 3) | (at(c.regs, a + 1) >> 5)

fn filter_at(n: Int) -> Int
    if n < 3
        return 4 * n
    0x10 + 4 * (n - 3)

// Whether filter `f` with mask `m` accepts a frame (§ 4.5): the filter's
// EXIDE bit must agree with the frame's type, the identifier bits under
// the mask must match, and for a standard frame the first two data bytes
// are compared with the filter's and the mask's EID15 to EID0.
fn filter_ok(c: Chip, f: Int, m: Int, id: Int, ext: Bool, d: Int, len: Int) -> Bool
    let fa = filter_at(f)
    let ma = 0x20 + 4 * m
    let fext = (at(c.regs, fa + 1) & 0x08) != 0
    if fext != ext
        return false
    if ((group_id(c, fa, ext) ^ id) & group_id(c, ma, ext)) != 0
        return false
    if not ext
        var d0 = 0
        var d1 = 0
        if len > 0
            d0 = byte_of(d, 0)
        if len > 1
            d1 = byte_of(d, 1)
        if ((at(c.regs, fa + 2) ^ d0) & at(c.regs, ma + 2)) != 0
            return false
        if ((at(c.regs, fa + 3) ^ d1) & at(c.regs, ma + 3)) != 0
            return false
    true

// The filter number that accepts the frame among `lo` to `hi`, or -1.
fn first_filter(c: Chip, lo: Int, hi: Int, m: Int, id: Int, ext: Bool, d: Int, len: Int) -> Int
    for f in lo..hi
        if filter_ok(c, f, m, id, ext, d, len)
            return f
    -1

// Writes a received frame into buffer `n` and sets its flag.
fn put_rx(c: Chip, n: Int, id: Int, ext: Bool, rtr: Bool, len: Int, d: Int, fil: Int)
    let base = 0x61 + 0x10 * n
    let r = mcp2515.id_regs(id, ext)
    c.regs.insert(base, (r >> 24) & 0xFF)
    var sidl = (r >> 16) & 0xFF
    if rtr and not ext
        sidl = sidl | 0x10
    c.regs.insert(base + 1, sidl)
    c.regs.insert(base + 2, (r >> 8) & 0xFF)
    c.regs.insert(base + 3, r & 0xFF)
    var dlc = len
    if rtr and ext
        dlc = dlc | 0x40
    c.regs.insert(base + 4, dlc)
    for i in 0..8
        c.regs.insert(base + 5 + i, byte_of(d, i))
    c.regs.insert(0x2C, at(c.regs, 0x2C) | (1 << n))
    c.st.insert(30 + n, fil)
    c.st.insert(41, at(c.st, 41) + 1)
    // The mode bits and BUKT are the driver's; the flags are the part's.
    var ctrl = at(c.regs, 0x60 + 0x10 * n) & 0x64
    if rtr
        ctrl = ctrl | 0x08
    ctrl = ctrl | (fil & 1)
    c.regs.insert(0x60 + 0x10 * n, ctrl)

// A frame arrives from the bus (§ 4): RXB0 first through its mask and
// filters, or taking everything with RXM 11; with RXB0 full and BUKT set it
// rolls over into RXB1; RXB1 then through its own mask and filters.  A
// frame that finds no buffer sets the overflow flag of the buffer it
// belonged to.
fn deliver(c: Chip, id: Int, ext: Bool, rtr: Bool, len: Int, d: Int)
    var l = len
    if rtr
        l = 0
    let rxm0 = (at(c.regs, 0x60) >> 5) & 3
    let rxm1 = (at(c.regs, 0x70) >> 5) & 3
    var f0 = -1
    if rxm0 == 3
        f0 = 0
    else
        f0 = first_filter(c, 0, 2, 0, id, ext, d, l)
    let full0 = (at(c.regs, 0x2C) & 1) != 0
    let full1 = (at(c.regs, 0x2C) & 2) != 0
    if f0 >= 0
        if not full0
            put_rx(c, 0, id, ext, rtr, len, d, f0)
            return
        if (at(c.regs, 0x60) & 4) != 0 and not full1
            put_rx(c, 1, id, ext, rtr, len, d, 6 + f0)
            return
        c.regs.insert(0x2D, at(c.regs, 0x2D) | 0x40)
        c.st.insert(42, at(c.st, 42) + 1)
        return
    var f1 = -1
    if rxm1 == 3
        f1 = 0
    else
        f1 = first_filter(c, 2, 6, 1, id, ext, d, l)
    if f1 >= 0
        if not full1
            put_rx(c, 1, id, ext, rtr, len, d, f1)
            return
        c.regs.insert(0x2D, at(c.regs, 0x2D) | 0x80)
        c.st.insert(42, at(c.st, 42) + 1)

// A frame injected from the bus, with the data bytes `d` packed.
fn inject(c: Chip, id: Int, ext: Bool, rtr: Bool, len: Int, d: Int)
    deliver(c, id, ext, rtr, len, d)

// The buffer the part sends next among those with TXREQ set: the highest
// priority, the highest number among equals; -1 for none.
fn next_tx(c: Chip) -> Int
    var best = -1
    var best_key = -1
    for b in 0..3
        let ctrl = at(c.regs, 0x30 + 0x10 * b)
        if (ctrl & 0x08) != 0
            let key = (ctrl & 3) * 4 + b
            if key > best_key
                best_key = key
                best = b
    best

// The bus runs: every pending buffer is sent in the order the part
// chooses, recorded in `sent` as id, flags (1 extended, 2 remote), length
// and data; in Loopback mode the frame also arrives at the receive side.
// Nothing is sent in Configuration, Listen-Only or Sleep mode.
fn bus_run(c: Chip)
    let mode = at(c.st, 2)
    if mode != 0 and mode != 2
        return
    var b = next_tx(c)
    while b >= 0
        let base = 0x31 + 0x10 * b
        let n = at(c.st, 40)
        let rtr = (at(c.regs, base + 4) & 0x40) != 0
        var flags = 0
        if ext_of(c, base)
            flags = 1
        if rtr
            flags = flags | 2
        c.sent.insert(4 * n, id_of(c, base))
        c.sent.insert(4 * n + 1, flags)
        c.sent.insert(4 * n + 2, len_of(c, base))
        c.sent.insert(4 * n + 3, data_of(c, base))
        c.st.insert(40, n + 1)
        c.regs.insert(0x30 + 0x10 * b, at(c.regs, 0x30 + 0x10 * b) & 0xF7)
        c.regs.insert(0x2C, at(c.regs, 0x2C) | (4 << b))
        if mode == 2
            deliver(c, id_of(c, base), ext_of(c, base), rtr, len_of(c, base), data_of(c, base))
        b = next_tx(c)

fn sent_id(c: Chip, n: Int) -> Int
    at(c.sent, 4 * n)

fn sent_flags(c: Chip, n: Int) -> Int
    at(c.sent, 4 * n + 1)

fn sent_len(c: Chip, n: Int) -> Int
    at(c.sent, 4 * n + 2)

fn sent_data(c: Chip, n: Int) -> Int
    at(c.sent, 4 * n + 3)

// READ STATUS (Figure 12-8) and RX STATUS (Figure 12-9) as the part
// answers them.
fn read_status(c: Chip) -> Int
    var s = at(c.regs, 0x2C) & 3
    for b in 0..3
        if (at(c.regs, 0x30 + 0x10 * b) & 0x08) != 0
            s = s | (4 << (2 * b))
        if (at(c.regs, 0x2C) & (4 << b)) != 0
            s = s | (8 << (2 * b))
    s

fn rx_status(c: Chip) -> Int
    let f = at(c.regs, 0x2C)
    var s = 0
    var n = 0
    if (f & 1) != 0
        s = 0x40
    elif (f & 2) != 0
        s = 0x80
        n = 1
    if (f & 3) == 3
        s = 0xC0
    if (f & 3) == 0
        return 0
    let base = 0x61 + 0x10 * n
    if (at(c.regs, base + 1) & 0x08) != 0
        s = s | 0x10
    if (at(c.regs, 0x60 + 0x10 * n) & 0x08) != 0
        s = s | 0x08
    s | (at(c.st, 30 + n) & 7)

// The address a LOAD TX BUFFER command starts at (Figure 12-5).
fn load_addr(abc: Int) -> Int
    0x31 + 0x10 * (abc >> 1) + 5 * (abc & 1)

// Chip select goes low: a transaction starts.
fn cs_low(c: Chip)
    log_push(c, -100)
    c.st.insert(6, 1)
    c.st.insert(8, -1)
    c.st.insert(10, 0)

// Chip select goes high: the transaction ends; READ RX BUFFER releases
// its buffer.
fn cs_high(c: Chip)
    c.st.insert(6, 0)
    if at(c.st, 8) == 0x90
        let n = at(c.st, 13)
        c.regs.insert(0x2C, at(c.regs, 0x2C) & (0xFF ^ (1 << n)))

// One byte of a transaction: the byte clocked out by the controller, and
// the byte the part answers.
fn xfer(c: Chip, b: Int) -> Int
    log_push(c, b)
    if at(c.st, 1) == 0
        return 0xFF
    let i = at(c.st, 10)
    c.st.insert(10, i + 1)
    if i == 0
        c.st.insert(8, b)
        if b == 0xC0
            c.st.insert(14, at(c.st, 14) + 1)
            if at(c.st, 15) > 0
                c.st.insert(15, at(c.st, 15) - 1)
            else
                reset_regs(c)
        elif (b & 0xF8) == 0x40
            c.st.insert(9, load_addr(b & 7))
        elif (b & 0xF8) == 0x80
            for n in 0..3
                if (b & (1 << n)) != 0
                    chip_modify(c, 0x30 + 0x10 * n, 0x08, 0x08)
        elif (b & 0xF9) == 0x90
            let n = (b >> 2) & 1
            c.st.insert(13, n)
            c.st.insert(8, 0x90)
            c.st.insert(9, 0x61 + 0x10 * n + 5 * ((b >> 1) & 1))
        return 0xFF
    let cmd = at(c.st, 8)
    if cmd == 0x03
        if i == 1
            c.st.insert(9, b)
            return 0xFF
        let a = at(c.st, 9)
        c.st.insert(9, a + 1)
        return chip_read(c, a)
    if cmd == 0x02
        if i == 1
            c.st.insert(9, b)
            return 0xFF
        let a = at(c.st, 9)
        c.st.insert(9, a + 1)
        chip_write(c, a, b)
        return 0xFF
    if cmd == 0x05
        if i == 1
            c.st.insert(11, b)
        elif i == 2
            c.st.insert(12, b)
        elif i == 3
            chip_modify(c, at(c.st, 11), at(c.st, 12), b)
        return 0xFF
    if (cmd & 0xF8) == 0x40
        let a = at(c.st, 9)
        c.st.insert(9, a + 1)
        c.regs.insert(a, b)
        return 0xFF
    if cmd == 0xA0
        return read_status(c)
    if cmd == 0xB0
        return rx_status(c)
    if cmd == 0x90
        let a = at(c.st, 9)
        c.st.insert(9, a + 1)
        return at(c.regs, a)
    0xFF

struct FakeSpi
    c: Chip

impl SpiBus for FakeSpi
    fn init(self, freq: Int, mode: Int) [hw]
        log_push(self.c, -302)
        log_push(self.c, freq)
        log_push(self.c, mode)

    fn transfer(self, b: Int) -> Int [hw]
        xfer(self.c, b)

    fn write(self, data: [u8]) [hw]
        for b in data
            let _ = xfer(self.c, b as Int)

    fn read(self, n: Int) -> [u8] [hw]
        var out: [u8] = []
        for _i in 0..n
            list.push(out, xfer(self.c, 0xFF) as u8)
        out

// The chip-select pin is 10 and the INT pin 9.
struct FakePins
    c: Chip

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        log_push(self.c, -301)
        log_push(self.c, pin)
        log_push(self.c, dir)

    fn set(self, pin: Int, val: Int) [hw]
        if pin == 10
            if val == 0
                cs_low(self.c)
                return
            if at(self.c.st, 6) == 1
                cs_high(self.c)
                return
        log_push(self.c, -300)
        log_push(self.c, pin)
        log_push(self.c, val)

    fn get(self, pin: Int) -> Int [hw]
        at(self.c.st, 19)

struct FakeTimer
    c: Chip

impl Timer for FakeTimer
    fn delay_us(self, us: Int) [hw]
        log_push(self.c, -200)
        log_push(self.c, us)

// The link over the double: the driver's own SPI framing over the double's
// bus and pins and timer.
struct TestLink
    c: Chip
    w: DeviceWiring

impl MccLink for TestLink
    fn link_xfer(self, tx: DevBytes, n: Int, var dst: DevBytes) -> Bool [hw]
        self.c.st.insert(24, at(self.c.st, 24) + 1)
        if at(self.c.st, 23) == at(self.c.st, 24)
            return false
        dev_bus.wiring_spi_exchange_into(FakeSpi { c: self.c }, FakePins { c: self.c }, self.w, tx, n, var dst)

    fn link_wait(self, us: Int) [hw]
        FakeTimer { c: self.c }.delay_us(us)

    fn link_irq(self) -> Int [hw]
        mcp2515.irq_level_of(FakePins { c: self.c }, self.w)

    fn link_setup(self) -> Bool [hw]
        mcp2515.spi_ready(FakeSpi { c: self.c }, FakePins { c: self.c }, self.w)

fn link(c: Chip) -> TestLink
    TestLink { c: c, w: dev_bus.wiring_irq(dev_bus.wiring_spi(0, 10), 9) }

// A wiring with chip select and no INT pin.
fn link_noirq(c: Chip) -> TestLink
    TestLink { c: c, w: dev_bus.wiring_spi(0, 10) }

// A wiring with no chip select, which the driver cannot use.
fn link_nocs(c: Chip) -> TestLink
    TestLink { c: c, w: dev_bus.wiring_i2c(0, 0x40) }

// Whether the log holds exactly the integers of `xs`.
fn log_is(c: Chip, xs: [Int]) -> Bool
    if at(c.log, -1) != xs.len()
        return false
    for i in 0..xs.len()
        if at(c.log, i) != xs[i]
            return false
    true

fn reg(c: Chip, a: Int) -> Int
    at(c.regs, a)

// Whether the log holds the value `v` anywhere.
fn log_has(c: Chip, v: Int) -> Bool
    for i in 0..at(c.log, -1)
        if at(c.log, i) == v
            return true
    false

fn std_frame(id: Int, len: Int, d: Int) -> CanBusFrame
    embedded_hal.can_data(id, len, d)

fn ext_frame(id: Int, len: Int, d: Int) -> CanBusFrame
    embedded_hal.can_data_ext(id, len, d)

// ── Bit timing ───────────────────────────────────────────────────────

@test
fn test_the_registers_of_the_reference_libraries_make_their_rates() [io]
    // Every row of the table decodes, by the data sheet's formula
    // osc / (2 x BRP' x N), to its rate, with 5 to 25 TQ a bit and a PS2
    // of at least 2 TQ.  33.3 kbit/s is 33333.3, 31.25 kbit/s is exact.
    let rates = [5000, 10000, 20000, 31250, 33333, 40000, 50000, 80000, 100000, 125000, 200000, 250000, 500000, 1000000]
    for osc in [8000000, 16000000]
        for rate in rates
            let t = mcp2515.bit_timing_known(osc, rate)
            if t >= 0
                test.assert_eq(mcp2515.timing_rate(osc, t), rate)
                let n = mcp2515.timing_tq(t)
                test.assert(n >= 5 and n <= 25)
                test.assert((mcp2515.timing_cnf3(t) & 7) >= 1)
    // 8 MHz has 13 rows and 16 MHz 13; the 1 Mbit/s row of 8 MHz is left out
    // because 8 MHz allows 4 TQ a bit.
    test.assert_eq(mcp2515.bit_timing_known(8000000, 1000000), -1)
    test.assert_eq(mcp2515.bit_timing_known(8000000, 31250) >= 0, true)
    test.assert_eq(mcp2515.bit_timing_known(16000000, 31250), -1)
    test.assert_eq(mcp2515.bit_timing_known(12000000, 500000), -1)

@test
fn test_the_known_values_for_the_usual_rates() [io]
    // The values of `coryjfowler/MCP_CAN_lib` and the `mcp2515` crate 0.3.0
    // (CNF3's SOF bit clear): 16 MHz at 500 kbit/s is 0x40, 0xE5, 0x03.
    let t = mcp2515.bit_timing_known(16000000, 500000)
    test.assert_eq(mcp2515.timing_cnf1(t), 0x40)
    test.assert_eq(mcp2515.timing_cnf2(t), 0xE5)
    test.assert_eq(mcp2515.timing_cnf3(t), 0x03)
    let u = mcp2515.bit_timing_known(8000000, 125000)
    test.assert_eq(mcp2515.timing_cnf1(u), 0x81)
    test.assert_eq(mcp2515.timing_cnf2(u), 0xE5)
    test.assert_eq(mcp2515.timing_cnf3(u), 0x03)
    let v = mcp2515.bit_timing_known(16000000, 1000000)
    test.assert_eq(mcp2515.bit_timing_pack(0x00, 0xCA, 0x01), v)
    // 16 MHz at 500 kbit/s: 75 % at 16 TQ, 12 TQ before the sample point.
    test.assert_eq(mcp2515.timing_tq(t), 16)
    test.assert_eq(mcp2515.timing_sample_permille(t), 750)
    // The packed form splits back into the three registers.
    let p = mcp2515.bit_timing_pack(0x12, 0x34, 0x56)
    test.assert_eq(mcp2515.timing_cnf1(p), 0x12)
    test.assert_eq(mcp2515.timing_cnf2(p), 0x34)
    test.assert_eq(mcp2515.timing_cnf3(p), 0x56)

@test
fn test_the_solver_finds_the_values_of_the_libraries() [io]
    // Where the solver and the libraries choose the same number of time
    // quanta, the registers are the same, with the SJW of the library and
    // CNF3's SOF bit clear.
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 500000, 750, 2, true), mcp2515.bit_timing_known(16000000, 500000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 250000, 750, 2, true), mcp2515.bit_timing_known(16000000, 250000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 125000, 750, 2, true), mcp2515.bit_timing_known(16000000, 125000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 1000000, 750, 1, true), mcp2515.bit_timing_known(16000000, 1000000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 200000, 750, 2, true), mcp2515.bit_timing_known(16000000, 200000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 50000, 750, 2, true), mcp2515.bit_timing_known(16000000, 50000))
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 5000, 750, 1, true), mcp2515.bit_timing_known(16000000, 5000))
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 250000, 750, 3, true), mcp2515.bit_timing_known(8000000, 250000))
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 125000, 750, 3, true), mcp2515.bit_timing_known(8000000, 125000))
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 100000, 750, 3, true), mcp2515.bit_timing_known(8000000, 100000))
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 200000, 750, 3, true), mcp2515.bit_timing_known(8000000, 200000))
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 31250, 750, 3, true), mcp2515.bit_timing_known(8000000, 31250))

@test
fn test_the_solver_makes_every_rate_the_table_has_at_its_sample_point() [io]
    // Where the solver picks another number of time quanta than the
    // libraries (more of them, for a finer sample point), the rate is the
    // same and the sample point is within 2 % of 75 %.
    for osc in [8000000, 16000000]
        for rate in [5000, 10000, 20000, 40000, 50000, 80000, 100000, 500000]
            let k = mcp2515.bit_timing_known(osc, rate)
            if k >= 0
                let t = mcp2515.bit_timing_solve(osc, rate, 750, 1, true)
                test.assert_eq(mcp2515.timing_rate(osc, t), rate)
                let sp = mcp2515.timing_sample_permille(t)
                test.assert(sp >= 650 and sp <= 770)

@test
fn test_the_solver_holds_the_segments_to_what_the_part_allows() [io]
    // 16 MHz at 20 kbit/s: BRP' 16 gives 25 TQ, whose 75 % needs 18 TQ before
    // the sample point; PropSeg and PS1 hold 16 at most, so it is 17 with 1
    // TQ (SyncSeg) and the sample point is 68 %, as the libraries give.
    let t = mcp2515.bit_timing_solve(16000000, 20000, 750, 1, true)
    test.assert_eq(mcp2515.timing_tq(t), 25)
    test.assert_eq(mcp2515.timing_sample_permille(t), 680)
    test.assert_eq(mcp2515.timing_cnf2(t), 0xFF)
    test.assert_eq(mcp2515.timing_cnf3(t), 0x07)
    // A low sample point is held by PS2's 8 TQ: 16 TQ at 30 % would want a
    // PS2 of 12.
    let low = mcp2515.bit_timing_solve(16000000, 500000, 300, 1, true)
    test.assert_eq(mcp2515.timing_cnf3(low) & 7, 7)
    test.assert_eq(mcp2515.timing_sample_permille(low), 500)
    // A high one by the minimum PS2 of 2 TQ.
    let high = mcp2515.bit_timing_solve(16000000, 500000, 990, 1, true)
    test.assert_eq(mcp2515.timing_cnf3(high) & 7, 1)
    // SJW is held to 1 to 4 and below PS2: PS2 of 2 TQ allows 1.
    test.assert_eq(mcp2515.timing_cnf1(high) >> 6, 0)
    test.assert_eq(mcp2515.timing_cnf1(mcp2515.bit_timing_solve(16000000, 500000, 750, 9, false)) >> 6, 2)
    test.assert_eq(mcp2515.timing_cnf1(mcp2515.bit_timing_solve(16000000, 500000, 750, 0, false)) >> 6, 0)
    // SAM is the sixth bit of CNF2.
    test.assert_eq(mcp2515.timing_cnf2(mcp2515.bit_timing_solve(16000000, 500000, 750, 1, false)) & 0x40, 0)
    test.assert_eq(mcp2515.timing_cnf2(mcp2515.bit_timing_solve(16000000, 500000, 750, 1, true)) & 0x40, 0x40)
    // The sample point is rounded to the nearest TQ: 800 kbit/s at 16 MHz is
    // 10 TQ, whose 75 % is 7.5, taken as 8 TQ before the sample point.
    let r = mcp2515.bit_timing_solve(16000000, 800000, 750, 1, true)
    test.assert_eq(mcp2515.timing_tq(r), 10)
    test.assert_eq(mcp2515.timing_sample_permille(r), 800)
    // BTLMODE is always set, so PS2 comes from CNF3.
    test.assert_eq(mcp2515.timing_cnf2(t) & 0x80, 0x80)

@test
fn test_a_rate_the_crystal_cannot_make_is_refused() [io]
    // 8 MHz at 1 Mbit/s is 4 TQ a bit, below the 5 the segments need.
    test.assert_eq(mcp2515.bit_timing_solve(8000000, 1000000, 750, 1, true), -1)
    test.assert_eq(mcp2515.bit_timing(8000000, 1000000), -1)
    // 12 MHz at 500 kbit/s is 12 TQ at BRP' 1, which is fine; 12 MHz at
    // 300 kbit/s is 20 TQ at BRP' 1.
    test.assert(mcp2515.bit_timing_solve(12000000, 500000, 750, 1, true) >= 0)
    // 16 MHz at 300 kbit/s has no exact divisor.
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 300000, 750, 1, true), -1)
    test.assert_eq(mcp2515.bit_timing_solve(0, 500000, 750, 1, true), -1)
    test.assert_eq(mcp2515.bit_timing_solve(16000000, 0, 750, 1, true), -1)
    // `bit_timing` takes the table first and the solver after it.
    test.assert_eq(mcp2515.bit_timing(16000000, 500000), mcp2515.bit_timing_known(16000000, 500000))
    test.assert_eq(mcp2515.bit_timing(12000000, 500000), mcp2515.bit_timing_solve(12000000, 500000, 750, 1, true))

@test
fn test_the_rate_of_every_solved_timing_is_exact() [io]
    // For three crystals and the usual rates, wherever the solver answers it
    // makes the rate exactly, within the 5 to 25 TQ a bit.
    for osc in [8000000, 12000000, 16000000, 20000000, 25000000]
        for rate in [10000, 20000, 50000, 100000, 125000, 250000, 500000, 800000, 1000000]
            let t = mcp2515.bit_timing_solve(osc, rate, 750, 1, true)
            if t >= 0
                test.assert_eq(mcp2515.timing_rate(osc, t), rate)
                test.assert(mcp2515.timing_tq(t) >= 5 and mcp2515.timing_tq(t) <= 25)
                test.assert((mcp2515.timing_cnf3(t) & 7) >= 1)

@test
fn test_ps2_without_btlmode_is_the_longer_of_ps1_and_two() [io]
    // CNF2 0x10: BTLMODE clear, PS1 3 TQ, PropSeg 1 TQ: PS2 is 3 TQ.
    test.assert_eq(mcp2515.timing_tq(mcp2515.bit_timing_pack(0, 0x10, 0)), 1 + 1 + 3 + 3)
    // PS1 of 1 TQ: PS2 is the 2 TQ minimum.
    test.assert_eq(mcp2515.timing_tq(mcp2515.bit_timing_pack(0, 0x00, 0)), 1 + 1 + 1 + 2)

// ── Frame encoding ───────────────────────────────────────────────────

@test
fn test_identifiers_are_spread_over_the_four_registers() [io]
    // A standard identifier: 0x123 is 001 0010 0011; SIDH 0x24, SIDL 0x60.
    let s = mcp2515.id_regs(0x123, false)
    test.assert_eq((s >> 24) & 0xFF, 0x24)
    test.assert_eq((s >> 16) & 0xFF, 0x60)
    test.assert_eq(s & 0xFFFF, 0)
    // An extended identifier: 0x12345678 adds EXIDE and the low 18 bits.
    let e = mcp2515.id_regs(0x12345678, true)
    test.assert_eq((e >> 24) & 0xFF, 0x91)
    test.assert_eq((e >> 16) & 0xFF, 0xA8 | 0x08 | 0x00)
    test.assert_eq((e >> 8) & 0xFF, 0x56)
    test.assert_eq(e & 0xFF, 0x78)
    // And back.
    test.assert_eq(mcp2515.regs_id(0x24, 0x60, 0, 0), 0x123)
    test.assert_eq(mcp2515.regs_id(0x91, 0xA8, 0x56, 0x78), 0x12345678)
    // The largest of each.
    let m = mcp2515.id_regs(0x1FFFFFFF, true)
    test.assert_eq(mcp2515.regs_id((m >> 24) & 0xFF, (m >> 16) & 0xFF, (m >> 8) & 0xFF, m & 0xFF), 0x1FFFFFFF)
    let n = mcp2515.id_regs(0x7FF, false)
    test.assert_eq(mcp2515.regs_id((n >> 24) & 0xFF, (n >> 16) & 0xFF, 0, 0), 0x7FF)

@test
fn test_a_receive_buffer_becomes_a_frame() [io]
    var b: DevBytes = Vec.new()
    // Standard data frame 0x123, 3 bytes.
    for x in [0x24, 0x60, 0x00, 0x00, 0x03, 0xAA, 0xBB, 0xCC, 0, 0, 0, 0, 0]
        let _ = b.push(x as u8)
    let f = mcp2515.frame_of_buffer(b)
    test.assert_eq(f.id, 0x123)
    test.assert(not f.extended)
    test.assert(not f.remote)
    test.assert_eq(f.len, 3)
    test.assert_eq(f.data, 0xCCBBAA)
    // A standard remote frame is flagged by SRR, SIDL bit 4, and carries no
    // data.
    var r: DevBytes = Vec.new()
    for x in [0x24, 0x70, 0x00, 0x00, 0x02, 0xAA, 0xBB, 0, 0, 0, 0, 0, 0]
        let _ = r.push(x as u8)
    let rf = mcp2515.frame_of_buffer(r)
    test.assert(rf.remote)
    test.assert_eq(rf.len, 2)
    test.assert_eq(rf.data, 0)
    // An extended remote frame is flagged by RTR, DLC bit 6.
    var e: DevBytes = Vec.new()
    for x in [0x91, 0xA8, 0x56, 0x78, 0x44, 0, 0, 0, 0, 0, 0, 0, 0]
        let _ = e.push(x as u8)
    let ef = mcp2515.frame_of_buffer(e)
    test.assert(ef.extended)
    test.assert(ef.remote)
    test.assert_eq(ef.id, 0x12345678)
    test.assert_eq(ef.len, 4)
    // A DLC above 8 is 8 bytes; the byte of bit 7 reaches the top of the
    // data word.
    var d: DevBytes = Vec.new()
    for x in [0x24, 0x60, 0x00, 0x00, 0x0F, 1, 2, 3, 4, 5, 6, 7, 0x80]
        let _ = d.push(x as u8)
    let df = mcp2515.frame_of_buffer(d)
    test.assert_eq(df.len, 8)
    test.assert_eq(embedded_hal.can_byte(df, 7), 0x80)
    test.assert_eq(embedded_hal.can_byte(df, 0), 1)

// ── The SPI instructions ─────────────────────────────────────────────

@test
fn test_each_instruction_is_one_transaction() [io]
    let c = running()
    let l = link(c)
    test.assert(mcp2515.reg_write(l, 0x2B, 0x05))
    test.assert_eq(mcp2515.reg_read(l, 0x2B) ?? -1, 0x05)
    test.assert(mcp2515.reg_modify(l, 0x2B, 0x0F, 0x0A))
    test.assert_eq(reg(c, 0x2B), 0x0A)
    // A read clocks out 0xFF for each byte it reads.
    test.assert(log_is(c, [-100, 0x02, 0x2B, 0x05, -100, 0x03, 0x2B, 0xFF, -100, 0x05, 0x2B, 0x0F, 0x0A]))
    var b: DevBytes = Vec.new()
    c.regs.insert(0x1C, 7)
    c.regs.insert(0x1D, 9)
    test.assert(mcp2515.regs_read(l, 0x1C, 2, var b))
    test.assert_eq(b[0] as Int, 7)
    test.assert_eq(b[1] as Int, 9)

@test
fn test_bit_modify_on_a_register_that_does_not_take_it_writes_the_byte() [io]
    // The double forces the mask to 0xFF as the part does (§ 12.10): a
    // driver that modified one bit of a filter register would overwrite the
    // rest.  The driver uses BIT MODIFY on the registers that take it only.
    let c = chip()
    c.regs.insert(0x00, 0xF0)
    test.assert(mcp2515.reg_modify(link(c), 0x00, 0x01, 0x01))
    test.assert_eq(reg(c, 0x00), 0x01)

@test
fn test_status_instructions_answer_one_byte() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.status_read(l), 0)
    c.regs.insert(0x2C, 0x03)
    c.regs.insert(0x30, 0x08)
    c.regs.insert(0x40, 0x08)
    c.regs.insert(0x50, 0x08)
    test.assert_eq(mcp2515.status_read(l), 0x03 | 0x04 | 0x10 | 0x40)
    test.assert_eq(mcp2515.tx_pending(l), 7)
    test.assert_eq(mcp2515.rx_status_read(l) & 0xC0, 0xC0)
    test.assert_eq(mcp2515.rx_status_filter(0x45), 5)
    test.assert_eq(mcp2515.rx_status_filter(0x06), 6)
    // A wiring with no chip select.
    test.assert_eq(mcp2515.status_read(link_nocs(c)), -1)
    test.assert_eq(mcp2515.rx_status_read(link_nocs(c)), -1)
    test.assert_eq(mcp2515.tx_pending(link_nocs(c)), -1)

// ── Open ─────────────────────────────────────────────────────────────

@test
fn test_open_runs_the_sequence() [io]
    let c = chip()
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, mcp2515.config_default()), 0)
    // The pins and the bus; RESET and the confirmation of Configuration
    // mode; CNF3, CNF2 and CNF1 written from 0x28 and read back; CANINTE;
    // RXB0CTRL with RXM 11 and BUKT, RXB1CTRL with RXM 11; CANCTRL by BIT
    // MODIFY with the mode and the options; the mode confirmed.
    test.assert(log_is(c, [
        -300, 10, 1,
        -301, 10, 1,
        -301, 9, 2,
        -302, 4000000, 0,
        -100, 0xC0,
        -200, 1000,
        -100, 0x03, 0x0E, 0xFF,
        -100, 0x02, 0x28, 0x03, 0xE5, 0x40,
        -100, 0x03, 0x28, 0xFF, 0xFF, 0xFF,
        -100, 0x02, 0x2B, 0x00,
        -100, 0x02, 0x60, 0x64,
        -100, 0x02, 0x70, 0x60,
        -100, 0x05, 0x0F, 0xEF, 0x00,
        -100, 0x03, 0x0E, 0xFF]))
    test.assert_eq(reg(c, 0x28), 0x03)
    test.assert_eq(reg(c, 0x29), 0xE5)
    test.assert_eq(reg(c, 0x2A), 0x40)
    test.assert_eq(at(c.st, 2), 0)
    test.assert_eq(at(c.st, 14), 1)

@test
fn test_open_writes_the_settings_it_is_given() [io]
    let c = chip()
    let s = Mcp2515Config { mode: 3, one_shot: true, rollover: false, accept_all: false,
                            irq_mask: 0x23, clkout: 4, timing: -1 }
    test.assert_eq(mcp2515.open_code(link_noirq(c), 8000000, 250000, s), 0)
    test.assert_eq(at(c.st, 2), 3)
    // OSM, CLKEN and a divider of 4 (CLKPRE 10).
    test.assert_eq(reg(c, 0x0F) & 0x1F, 0x08 | 0x04 | 0x02)
    test.assert_eq(reg(c, 0x2B), 0x23)
    // RXM 00 in both, no rollover.
    test.assert_eq(reg(c, 0x60), 0x00)
    test.assert_eq(reg(c, 0x70), 0x00)
    // The 8 MHz table row for 250 kbit/s.
    test.assert_eq(reg(c, 0x2A), 0x80)
    test.assert_eq(reg(c, 0x29), 0xE5)
    test.assert_eq(reg(c, 0x28), 0x03)

@test
fn test_the_clkout_divider_is_clkpre() [io]
    // CLKPRE 00 is /1, 01 /2, 10 /4, 11 /8; 0 turns the pin off.
    for case in [[1, 0x04], [2, 0x05], [4, 0x06], [8, 0x07], [0, 0x00]]
        let c = chip()
        let s = Mcp2515Config { mode: 0, one_shot: false, rollover: true, accept_all: true,
                                irq_mask: 0, clkout: case[0], timing: -1 }
        test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, s), 0)
        test.assert_eq(reg(c, 0x0F) & 0x0F, case[1])

@test
fn test_open_takes_the_timing_it_is_given() [io]
    let c = chip()
    let t = mcp2515.bit_timing_solve(16000000, 400000, 800, 1, false)
    test.assert(t >= 0)
    let s = Mcp2515Config { mode: 0, one_shot: false, rollover: true, accept_all: true,
                            irq_mask: 0, clkout: 0, timing: t }
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 400000, s), 0)
    test.assert_eq(reg(c, 0x2A), mcp2515.timing_cnf1(t))
    test.assert_eq(reg(c, 0x29), mcp2515.timing_cnf2(t))
    test.assert_eq(reg(c, 0x28), mcp2515.timing_cnf3(t))

@test
fn test_open_reports_what_went_wrong() [io]
    let c = chip()
    let d = mcp2515.config_default()
    // A rate the crystal cannot make: nothing is sent.
    test.assert_eq(mcp2515.open_code(link(c), 8000000, 1000000, d), -3)
    test.assert(log_is(c, []))
    // A mode outside 0 to 4.
    let bad = Mcp2515Config { mode: 7, one_shot: false, rollover: true, accept_all: true,
                              irq_mask: 0, clkout: 0, timing: -1 }
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, bad), -2)
    let neg = Mcp2515Config { mode: -1, one_shot: false, rollover: true, accept_all: true,
                              irq_mask: 0, clkout: 0, timing: -1 }
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, neg), -2)
    // A wiring with no chip select.
    test.assert_eq(mcp2515.open_code(link_nocs(c), 16000000, 500000, d), -1)
    // No part: the confirmation of Configuration mode fails ten times.
    let none = chip()
    none.st.insert(1, 0)
    test.assert_eq(mcp2515.open_code(link(none), 16000000, 500000, d), -1)
    // Transactions 3 to 8 are the writes and the read-back after the reset;
    // each failing is -1.  Failing the first reset, the first
    // confirmation or the last read of the mode is made good by the retry.
    for n in 3..9
        let f = chip()
        f.st.insert(23, n)
        test.assert_eq(mcp2515.open_code(link(f), 16000000, 500000, d), -1)
    for n in [1, 2, 9]
        let g = chip()
        g.st.insert(23, n)
        test.assert_eq(mcp2515.open_code(link(g), 16000000, 500000, d), 0)

@test
fn test_open_reads_the_timing_back() [io]
    // A part that does not take the bit timing reads back its old values
    // and is refused.
    let c = chip()
    c.st.insert(25, 1)
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, mcp2515.config_default()), -4)

@test
fn test_open_checks_each_of_the_three_timing_registers() [io]
    // A part that keeps CNF1 at zero while taking CNF2 and CNF3 is refused too.
    let c = chip()
    c.st.insert(25, 2)
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, mcp2515.config_default()), -4)

@test
fn test_open_reports_a_mode_that_does_not_come() [io]
    let c = chip()
    c.st.insert(3, 100000)
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, mcp2515.config_default()), -5)

@test
fn test_the_reset_is_repeated_for_a_slow_crystal() [io]
    let c = chip()
    c.st.insert(15, 2)
    c.st.insert(2, 0)
    test.assert(mcp2515.reset(link(c)))
    test.assert_eq(at(c.st, 14), 3)
    // Twenty ignored resets are more than the ten tried.
    let d = chip()
    d.st.insert(15, 20)
    d.st.insert(2, 0)
    test.assert(not mcp2515.reset(link(d)))
    test.assert_eq(at(d.st, 14), 10)
    // A wiring with no chip select.
    test.assert(not mcp2515.reset(link_nocs(c)))

@test
fn test_a_mode_change_waits_for_the_bus() [io]
    // CANSTAT shows the old mode for three reads: the driver polls every
    // 100 us.
    let c = chip()
    c.st.insert(3, 3)
    test.assert(mcp2515.mode_set(link(c), 0))
    test.assert_eq(at(c.st, 2), 0)
    test.assert(log_is(c, [
        -100, 0x05, 0x0F, 0xE0, 0x00,
        -100, 0x03, 0x0E, 0xFF, -200, 100,
        -100, 0x03, 0x0E, 0xFF, -200, 100,
        -100, 0x03, 0x0E, 0xFF, -200, 100,
        -100, 0x03, 0x0E, 0xFF]))
    // A mode that does not come within 50 ms.
    let d = chip()
    d.st.insert(3, 100000)
    test.assert(not mcp2515.mode_set(link(d), 0))
    // A mode outside 0 to 4 is refused without a transaction.
    log_clear(c)
    test.assert(not mcp2515.mode_set(link(c), 5))
    test.assert(not mcp2515.mode_set(link(c), -1))
    test.assert(log_is(c, []))
    // A wiring with no chip select.
    test.assert(not mcp2515.mode_set(link_nocs(c), 0))

@test
fn test_the_configuration_mode_calls() [io]
    let c = running()
    let l = link(c)
    test.assert(mcp2515.config_enter(l))
    test.assert_eq(mcp2515.mode_read(l) ?? -1, 4)
    test.assert(mcp2515.config_leave(l, 2))
    test.assert_eq(mcp2515.mode_read(l) ?? -1, 2)
    test.assert(mcp2515.mode_read(link_nocs(c)) == None)

@test
fn test_open_by_the_canbus_trait_modes() [io]
    let c = chip()
    test.assert(mcp2515.open_simple(link(c), 16000000, 500000, 0))
    test.assert_eq(at(c.st, 2), 0)
    let d = chip()
    test.assert(mcp2515.open_simple(link(d), 16000000, 500000, 1))
    test.assert_eq(at(d.st, 2), 2)
    // A mode the trait does not name, and a rate that cannot be made.
    let e = chip()
    test.assert(not mcp2515.open_simple(link(e), 16000000, 500000, 2))
    test.assert(not mcp2515.open_simple(link(e), 8000000, 1000000, 0))

// ── Transmit ─────────────────────────────────────────────────────────

@test
fn test_a_frame_is_loaded_and_requested() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x123, 3, 0xCCBBAA)), 0)
    // READ STATUS; BIT MODIFY of TXP (priority 2 for buffer 0); LOAD TX
    // BUFFER at TXB0SIDH with SIDH, SIDL, EID8, EID0, DLC and the data;
    // RTS for buffer 0.
    test.assert(log_is(c, [
        -100, 0xA0, 0xFF,
        -100, 0x05, 0x30, 0x03, 0x02,
        -100, 0x40, 0x24, 0x60, 0x00, 0x00, 0x03, 0xAA, 0xBB, 0xCC,
        -100, 0x81]))
    bus_run(c)
    test.assert_eq(sent_id(c, 0), 0x123)
    test.assert_eq(sent_len(c, 0), 3)
    test.assert_eq(sent_data(c, 0), 0xCCBBAA)
    test.assert_eq(sent_flags(c, 0), 0)

@test
fn test_an_extended_frame_sets_exide() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, ext_frame(0x12345678, 1, 0x5A)), 0)
    test.assert_eq(reg(c, 0x32) & 0x08, 0x08)
    bus_run(c)
    test.assert_eq(sent_id(c, 0), 0x12345678)
    test.assert_eq(sent_flags(c, 0), 1)
    test.assert_eq(sent_data(c, 0), 0x5A)

@test
fn test_a_remote_frame_loads_the_header_only() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, embedded_hal.can_remote(0x321, false, 4)), 0)
    // SIDH, SIDL, EID8, EID0 and a DLC with RTR (bit 6) and the length; no
    // data bytes.
    test.assert(log_is(c, [
        -100, 0xA0, 0xFF,
        -100, 0x05, 0x30, 0x03, 0x02,
        -100, 0x40, 0x64, 0x20, 0x00, 0x00, 0x44,
        -100, 0x81]))
    bus_run(c)
    test.assert_eq(sent_flags(c, 0), 2)
    test.assert_eq(sent_len(c, 0), 4)

@test
fn test_queued_frames_leave_in_the_order_they_were_queued() [io]
    // The part sends the highest priority first and, among equals, the
    // highest buffer number first.  The driver gives buffers 0, 1 and 2 the
    // priorities 2, 1 and 0 and fills them in order, so three frames leave
    // as they were queued.
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x100, 0, 0)), 0)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x200, 0, 0)), 1)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x300, 0, 0)), 2)
    test.assert_eq(reg(c, 0x30) & 3, 2)
    test.assert_eq(reg(c, 0x40) & 3, 1)
    test.assert_eq(reg(c, 0x50) & 3, 0)
    // A fourth finds all three waiting.
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x400, 0, 0)), -1)
    bus_run(c)
    test.assert_eq(sent_id(c, 0), 0x100)
    test.assert_eq(sent_id(c, 1), 0x200)
    test.assert_eq(sent_id(c, 2), 0x300)
    test.assert_eq(at(c.st, 40), 3)

@test
fn test_the_next_frame_goes_behind_the_ones_waiting() [io]
    // With buffer 1 waiting and buffer 0 free, the next frame goes to buffer
    // 2, behind it; sent into buffer 0 it would overtake.
    let c = running()
    let l = link(c)
    c.regs.insert(0x40, 0x08 | 1)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x111, 0, 0)), 2)
    // With only buffer 0 waiting it goes to buffer 1.
    let d = running()
    d.regs.insert(0x30, 0x08 | 2)
    test.assert_eq(mcp2515.send_frame(link(d), std_frame(0x111, 0, 0)), 1)
    // With buffer 2 waiting there is no place behind it.
    let e = running()
    e.regs.insert(0x50, 0x08)
    test.assert_eq(mcp2515.send_frame(link(e), std_frame(0x111, 0, 0)), -1)

@test
fn test_a_frame_at_a_higher_priority_overtakes() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x100, 0, 0), 0), 0)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x200, 0, 0), 3), 1)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x300, 0, 0), 1), 2)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x400, 0, 0), 1), -1)
    bus_run(c)
    // 3, then 1, then 0.
    test.assert_eq(sent_id(c, 0), 0x200)
    test.assert_eq(sent_id(c, 1), 0x300)
    test.assert_eq(sent_id(c, 2), 0x100)

@test
fn test_equal_priorities_send_the_higher_buffer_first() [io]
    // The pitfall `send_frame` avoids: two frames at one priority leave in
    // the reverse order.
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x100, 0, 0), 1), 0)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x200, 0, 0), 1), 1)
    bus_run(c)
    test.assert_eq(sent_id(c, 0), 0x200)
    test.assert_eq(sent_id(c, 1), 0x100)

@test
fn test_a_frame_that_cannot_be_sent_is_refused() [io]
    let c = running()
    let l = link(c)
    // An identifier too wide for its type, a length past 8.
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x800, 0, 0)), -2)
    test.assert_eq(mcp2515.send_frame(l, ext_frame(0x20000000, 0, 0)), -2)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x1, 9, 0)), -2)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x1, 0, 0), 4), -2)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x1, 0, 0), -1), -2)
    test.assert_eq(mcp2515.send_prio(l, std_frame(0x800, 0, 0), 1), -2)
    test.assert(log_is(c, []))
    // A wiring with no chip select, and a part that stops answering at each
    // step of a send.
    test.assert_eq(mcp2515.send_frame(link_nocs(c), std_frame(0x1, 0, 0)), -3)
    test.assert_eq(mcp2515.send_prio(link_nocs(c), std_frame(0x1, 0, 0), 1), -3)
    for n in 1..5
        let f = running()
        f.st.insert(23, n)
        test.assert_eq(mcp2515.send_frame(link(f), std_frame(0x1, 0, 0)), -3)
        let g = running()
        g.st.insert(23, n)
        test.assert_eq(mcp2515.send_prio(link(g), std_frame(0x1, 0, 0), 1), -3)

@test
fn test_a_free_buffer_for_an_explicit_priority_is_the_lowest() [io]
    let c = running()
    c.regs.insert(0x30, 0x08)
    test.assert_eq(mcp2515.send_prio(link(c), std_frame(0x1, 0, 0), 1), 1)
    let d = running()
    d.regs.insert(0x30, 0x08)
    d.regs.insert(0x40, 0x08)
    test.assert_eq(mcp2515.send_prio(link(d), std_frame(0x1, 0, 0), 1), 2)
    // The CanBus trait's send answers whether a buffer took the frame.
    let e = running()
    e.regs.insert(0x50, 0x08)
    test.assert(mcp2515.send_frame(link(e), std_frame(0x1, 0, 0)) < 0)

@test
fn test_transmission_is_idle_when_no_buffer_waits() [io]
    let c = running()
    let l = link(c)
    test.assert(mcp2515.tx_idle(l))
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x1, 0, 0)), 0)
    test.assert(not mcp2515.tx_idle(l))
    bus_run(c)
    test.assert(mcp2515.tx_idle(l))
    // Before open the part is in Configuration mode: not idle.
    let n = chip()
    test.assert(not mcp2515.tx_idle(link(n)))
    test.assert(not mcp2515.tx_idle(link_nocs(c)))

@test
fn test_all_pending_frames_can_be_aborted() [io]
    let c = running()
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x1, 0, 0)), 0)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x2, 0, 0)), 1)
    log_clear(c)
    test.assert(mcp2515.tx_abort_all(l))
    // ABAT set, TXREQ read, ABAT cleared.
    test.assert(log_is(c, [-100, 0x05, 0x0F, 0x10, 0x10, -100, 0xA0, 0xFF, -100, 0x05, 0x0F, 0x10, 0x00]))
    test.assert_eq(mcp2515.tx_pending(l), 0)
    // Frames the part cannot abort stay: the abort is cleared and the answer
    // is false.
    let d = running()
    d.st.insert(22, 1)
    d.regs.insert(0x30, 0x08)
    test.assert(not mcp2515.tx_abort_all(link(d)))
    test.assert_eq(reg(d, 0x0F) & 0x10, 0)
    test.assert(not mcp2515.tx_abort_all(link_nocs(d)))

@test
fn test_one_shot_is_a_bit_of_canctrl() [io]
    let c = running()
    let l = link(c)
    test.assert(mcp2515.one_shot_set(l, true))
    test.assert_eq(reg(c, 0x0F) & 0x08, 0x08)
    test.assert(mcp2515.one_shot_set(l, false))
    test.assert_eq(reg(c, 0x0F) & 0x08, 0)
    test.assert(log_is(c, [-100, 0x05, 0x0F, 0x08, 0x08, -100, 0x05, 0x0F, 0x08, 0x00]))

// ── Receive ──────────────────────────────────────────────────────────

// A part opened for every frame, in Normal mode.
fn opened() -> Chip
    let c = chip()
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, mcp2515.config_default()), 0)
    log_clear(c)
    c

@test
fn test_a_frame_is_read_in_one_transaction_that_frees_the_buffer() [io]
    let c = opened()
    let l = link(c)
    inject(c, 0x123, false, false, 2, 0xBBAA)
    let f = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert_eq(f.id, 0x123)
    test.assert_eq(f.len, 2)
    test.assert_eq(f.data, 0xBBAA)
    test.assert(not f.extended)
    // RX STATUS, then READ RX BUFFER for buffer 0 and 13 bytes.
    test.assert(log_is(c, [
        -100, 0xB0, 0xFF,
        -100, 0x90, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]))
    // The instruction cleared RX0IF when CS rose.
    test.assert_eq(reg(c, 0x2C) & 1, 0)
    log_clear(c)
    test.assert(mcp2515.receive_frame(l) == None)
    test.assert(log_is(c, [-100, 0xB0, 0xFF]))

@test
fn test_a_frame_in_the_second_buffer_is_read_after_the_first() [io]
    let c = opened()
    let l = link(c)
    inject(c, 0x111, false, false, 0, 0)
    // RXB0 is full and BUKT is set: the second frame rolls over into RXB1.
    inject(c, 0x222, false, false, 1, 0x55)
    test.assert_eq(reg(c, 0x2C) & 3, 3)
    test.assert_eq(at(c.st, 31), 6)
    test.assert_eq((mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)).id, 0x111)
    let b = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert_eq(b.id, 0x222)
    test.assert_eq(b.data, 0x55)
    test.assert(mcp2515.receive_frame(l) == None)
    // READ RX BUFFER for buffer 1 is 0x94, for buffer 0 0x90.
    test.assert(log_has(c, 0x94))
    test.assert(log_has(c, 0x90))

@test
fn test_without_rollover_the_second_frame_is_lost_and_flagged() [io]
    let c = chip()
    let s = Mcp2515Config { mode: 0, one_shot: false, rollover: false, accept_all: true,
                            irq_mask: 0, clkout: 0, timing: -1 }
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, s), 0)
    let l = link(c)
    inject(c, 0x111, false, false, 0, 0)
    inject(c, 0x222, false, false, 0, 0)
    test.assert_eq(at(c.st, 42), 1)
    test.assert_eq(mcp2515.eflg_read(l) ?? -1, 0x40)
    test.assert((mcp2515.irq_flags(l) ?? -1) == 1)
    test.assert(mcp2515.eflg_clear_overflow(l))
    test.assert_eq(mcp2515.eflg_read(l) ?? -1, 0)
    // Both overflow flags go, and the warning flags do not.
    c.regs.insert(0x2D, 0xC0 | 0x01)
    test.assert(mcp2515.eflg_clear_overflow(l))
    test.assert_eq(mcp2515.eflg_read(l) ?? -1, 0x01)
    test.assert_eq((mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)).id, 0x111)
    test.assert(mcp2515.receive_frame(l) == None)

@test
fn test_remote_and_extended_frames_are_decoded() [io]
    let c = opened()
    let l = link(c)
    inject(c, 0x12345678, true, false, 8, 0x0807060504030201)
    let e = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert(e.extended)
    test.assert_eq(e.id, 0x12345678)
    test.assert_eq(e.len, 8)
    test.assert_eq(embedded_hal.can_byte(e, 7), 8)
    inject(c, 0x321, false, true, 4, 0)
    let r = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert(r.remote)
    test.assert_eq(r.len, 4)
    test.assert_eq(r.id, 0x321)
    inject(c, 0x1ABCDE, true, true, 2, 0)
    let x = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert(x.remote and x.extended)
    test.assert_eq(x.id, 0x1ABCDE)

@test
fn test_the_int_pin_decides_whether_to_look() [io]
    let c = opened()
    let l = link(c)
    inject(c, 0x123, false, false, 0, 0)
    // The pin is high: no transaction.
    c.st.insert(19, 1)
    test.assert(mcp2515.receive_irq(l) == None)
    test.assert(log_is(c, []))
    // Low: the frame is read.
    c.st.insert(19, 0)
    test.assert_eq((mcp2515.receive_irq(l) ?? std_frame(0, 0, 0)).id, 0x123)
    test.assert_eq(mcp2515.irq_level(l), 0)
    // A wiring with no INT pin polls.
    inject(c, 0x124, false, false, 0, 0)
    test.assert_eq(mcp2515.irq_level(link_noirq(c)), -1)
    test.assert_eq((mcp2515.receive_irq(link_noirq(c)) ?? std_frame(0, 0, 0)).id, 0x124)

@test
fn test_a_part_that_does_not_answer_receives_nothing() [io]
    let c = opened()
    inject(c, 0x123, false, false, 0, 0)
    test.assert(mcp2515.receive_frame(link_nocs(c)) == None)
    // The read of the buffer failing after the status.
    let d = opened()
    inject(d, 0x123, false, false, 0, 0)
    d.st.insert(24, 0)
    d.st.insert(23, 2)
    test.assert(mcp2515.receive_frame(link(d)) == None)

// ── Masks and filters ────────────────────────────────────────────────

@test
fn test_masks_and_filters_are_written_in_configuration_mode_only() [io]
    let c = running()
    let l = link(c)
    test.assert(not mcp2515.filter_set(l, 0, 0x100, false))
    test.assert(not mcp2515.mask_set(l, 0, 0x7FF, false))
    test.assert(mcp2515.config_enter(l))
    log_clear(c)
    test.assert(mcp2515.filter_set(l, 0, 0x100, false))
    // CANSTAT is read first, then four bytes are written from RXF0SIDH and
    // read back.
    test.assert(log_is(c, [
        -100, 0x03, 0x0E, 0xFF,
        -100, 0x02, 0x00, 0x20, 0x00, 0x00, 0x00,
        -100, 0x03, 0x00, 0xFF, 0xFF, 0xFF, 0xFF]))
    test.assert(mcp2515.filter_set(l, 5, 0x1FFFFFFF, true))
    test.assert_eq(reg(c, 0x18), 0xFF)
    test.assert_eq(reg(c, 0x19) & 0x0B, 0x0B)
    test.assert(mcp2515.mask_set(l, 1, 0x7F0, false))
    test.assert_eq(reg(c, 0x24), 0xFE)
    test.assert_eq(reg(c, 0x25), 0x00)
    // A mask has no EXIDE bit, even for an extended identifier.
    test.assert(mcp2515.mask_set(l, 0, 0x1FFFFFFF, true))
    test.assert_eq(reg(c, 0x21) & 0x08, 0)
    test.assert_eq(reg(c, 0x21) & 0xE3, 0xE3)
    // Out of range.
    test.assert(not mcp2515.filter_set(l, 6, 0, false))
    test.assert(not mcp2515.filter_set(l, -1, 0, false))
    test.assert(not mcp2515.mask_set(l, 2, 0, false))
    test.assert(not mcp2515.mask_set(l, -1, 0, false))
    // The registers read zero outside Configuration mode.
    test.assert(mcp2515.config_leave(l, 0))
    test.assert_eq(mcp2515.reg_read(l, 0x18) ?? -1, 0)
    test.assert_eq(mcp2515.reg_read(l, 0x24) ?? -1, 0)

@test
fn test_each_filter_has_its_own_address() [io]
    // RXF0 to RXF2 at 0x00, 0x04 and 0x08; RXF3 to RXF5 at 0x10, 0x14 and
    // 0x18 (Table 11-1).
    let c = chip()
    let l = link(c)
    for n in 0..6
        test.assert(mcp2515.filter_set(l, n, 0x100 + n, false))
    test.assert_eq(reg(c, 0x00), 0x20)
    test.assert_eq(reg(c, 0x04), 0x20)
    test.assert_eq(reg(c, 0x05), 0x20)
    test.assert_eq(reg(c, 0x09), 0x40)
    test.assert_eq(reg(c, 0x11), 0x60)
    test.assert_eq(reg(c, 0x15), 0x80)
    test.assert_eq(reg(c, 0x19), 0xA0)

@test
fn test_a_filter_write_that_does_not_read_back_is_refused() [io]
    let c = chip()
    c.st.insert(26, 1)
    test.assert(not mcp2515.filter_set(link(c), 0, 0x100, false))
    // The part failing to answer at each step.
    for n in 1..4
        let f = chip()
        f.st.insert(23, n)
        test.assert(not mcp2515.filter_set(link(f), 0, 0x100, false))

@test
fn test_the_masks_and_filters_decide_what_is_received() [io]
    let c = chip()
    let l = link(c)
    test.assert(mcp2515.config_enter(l))
    // Mask 0 compares all 11 bits, filters 0 and 1 are 0x100 and 0x200;
    // mask 1 compares the upper 7, filter 2 is 0x300.
    test.assert(mcp2515.mask_set(l, 0, 0x7FF, false))
    test.assert(mcp2515.filter_set(l, 0, 0x100, false))
    test.assert(mcp2515.filter_set(l, 1, 0x200, false))
    test.assert(mcp2515.mask_set(l, 1, 0x7F0, false))
    for n in 2..6
        test.assert(mcp2515.filter_set(l, n, 0x300, false))
    test.assert(mcp2515.rx_mode_set(l, false, false))
    test.assert(mcp2515.config_leave(l, 0))
    test.assert_eq(reg(c, 0x60), 0x00)
    test.assert_eq(reg(c, 0x70), 0x00)
    // 0x555 matches nothing and is dropped; an extended frame is not for
    // these standard filters.
    inject(c, 0x555, false, false, 0, 0)
    inject(c, 0x100, true, false, 0, 0)
    test.assert_eq(reg(c, 0x2C) & 3, 0)
    // 0x200 is filter 1 of RXB0, with the data bytes not compared.
    inject(c, 0x200, false, false, 2, 0x1234)
    test.assert_eq(mcp2515.rx_status_read(l) & 0xFF, 0x40 | 1)
    // 0x305 matches filter 2 under the mask 0x7F0, and goes to RXB1.
    inject(c, 0x305, false, false, 0, 0)
    test.assert_eq(reg(c, 0x2C) & 3, 3)
    test.assert_eq((mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)).id, 0x200)
    test.assert_eq(mcp2515.rx_status_read(l) & 0xFF, 0x80 | 2)
    test.assert_eq((mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)).id, 0x305)

@test
fn test_a_standard_filter_that_has_eid_bits_compares_the_data_bytes() [io]
    // The pitfall `mask_set` and `filter_set` avoid by writing EID8 and EID0
    // as zero: with RXM 00 the part compares the first two data bytes of a
    // standard frame with EID15 to EID0 of the filter under the mask.
    let c = chip()
    let l = link(c)
    test.assert(mcp2515.config_enter(l))
    test.assert(mcp2515.mask_set(l, 0, 0x7FF, false))
    test.assert(mcp2515.filter_set(l, 0, 0x100, false))
    // RXB1 gets a mask and filters that nothing here matches.
    test.assert(mcp2515.mask_set(l, 1, 0x7FF, false))
    for n in 2..6
        test.assert(mcp2515.filter_set(l, n, 0x700, false))
    // Filter 0 wants 0x55 as the first data byte; mask 0 asks for it.
    test.assert(mcp2515.reg_write(l, 0x02, 0x55))
    test.assert(mcp2515.reg_write(l, 0x22, 0xFF))
    test.assert(mcp2515.rx_mode_set(l, false, false))
    test.assert(mcp2515.config_leave(l, 0))
    inject(c, 0x100, false, false, 2, 0x0011)
    test.assert_eq(reg(c, 0x2C) & 3, 0)
    inject(c, 0x100, false, false, 2, 0x0055)
    test.assert_eq(reg(c, 0x2C) & 3, 1)

@test
fn test_extended_filters_compare_all_29_bits() [io]
    let c = chip()
    let l = link(c)
    test.assert(mcp2515.config_enter(l))
    test.assert(mcp2515.mask_set(l, 0, 0x1FFFFFFF, true))
    test.assert(mcp2515.filter_set(l, 0, 0x12345678, true))
    test.assert(mcp2515.filter_set(l, 1, 0x12345678, true))
    test.assert(mcp2515.mask_set(l, 1, 0x1FFFFFFF, true))
    for n in 2..6
        test.assert(mcp2515.filter_set(l, n, 0x1FFFFFFF, true))
    test.assert(mcp2515.rx_mode_set(l, false, false))
    test.assert(mcp2515.config_leave(l, 0))
    inject(c, 0x12345679, true, false, 0, 0)
    test.assert_eq(reg(c, 0x2C) & 3, 0)
    inject(c, 0x12345678, true, false, 0, 0)
    test.assert_eq(reg(c, 0x2C) & 3, 1)
    // A standard frame with the same low bits is not accepted.
    inject(c, 0x678, false, false, 0, 0)
    test.assert_eq(reg(c, 0x2C) & 3, 1)

@test
fn test_the_receive_modes_are_set_in_any_mode() [io]
    let c = running()
    let l = link(c)
    test.assert(mcp2515.rx_mode_set(l, true, true))
    test.assert_eq(reg(c, 0x60), 0x64)
    test.assert_eq(reg(c, 0x70), 0x60)
    test.assert(mcp2515.rx_mode_set(l, false, false))
    test.assert_eq(reg(c, 0x60), 0x00)
    test.assert_eq(reg(c, 0x70), 0x00)
    test.assert(log_is(c, [
        -100, 0x05, 0x60, 0x64, 0x64,
        -100, 0x05, 0x70, 0x60, 0x60,
        -100, 0x05, 0x60, 0x64, 0x00,
        -100, 0x05, 0x70, 0x60, 0x00]))
    test.assert(not mcp2515.rx_mode_set(link_nocs(c), true, true))
    let f = running()
    f.st.insert(23, 2)
    test.assert(not mcp2515.rx_mode_set(link(f), true, true))

// ── Interrupts, errors ───────────────────────────────────────────────

@test
fn test_the_interrupt_flags_are_read_cleared_and_enabled() [io]
    let c = running()
    let l = link(c)
    c.regs.insert(0x2C, 0xE3)
    test.assert_eq(mcp2515.irq_flags(l) ?? -1, 0xE3)
    test.assert(mcp2515.irq_clear(l, 0xE0))
    test.assert_eq(reg(c, 0x2C), 0x03)
    test.assert(mcp2515.irq_enable(l, 0x23))
    test.assert_eq(reg(c, 0x2B), 0x23)
    test.assert(log_is(c, [-100, 0x03, 0x2C, 0xFF, -100, 0x05, 0x2C, 0xE0, 0x00, -100, 0x02, 0x2B, 0x23]))

@test
fn test_the_error_counters_and_the_fault_state_are_read() [io]
    let c = running()
    let l = link(c)
    c.regs.insert(0x1C, 100)
    c.regs.insert(0x1D, 200)
    let a = mcp2515.errors_read(l) ?? CanBusErrors0()
    test.assert_eq(a.tx, 100)
    test.assert_eq(a.rx, 200)
    test.assert_eq(a.state, 0)
    test.assert(log_is(c, [-100, 0x03, 0x1C, 0xFF, 0xFF, -100, 0x03, 0x2D, 0xFF]))
    // Error-passive from either flag, bus-off from TXBO (which is set with
    // TXEP), and the overflow flags do not change the state.
    c.regs.insert(0x2D, 0x10)
    test.assert_eq((mcp2515.errors_read(l) ?? CanBusErrors0()).state, 1)
    c.regs.insert(0x2D, 0x08)
    test.assert_eq((mcp2515.errors_read(l) ?? CanBusErrors0()).state, 1)
    c.regs.insert(0x2D, 0x20 | 0x10)
    test.assert_eq((mcp2515.errors_read(l) ?? CanBusErrors0()).state, 2)
    c.regs.insert(0x2D, 0xC0)
    test.assert_eq((mcp2515.errors_read(l) ?? CanBusErrors0()).state, 0)
    // The part not answering, at each of the two reads.
    test.assert(mcp2515.errors_read(link_nocs(c)) == None)
    let d = running()
    d.st.insert(23, 2)
    test.assert(mcp2515.errors_read(link(d)) == None)
    // The CanBus form answers zeros and error-active.
    test.assert_eq(mcp2515.errors_or_idle(link_nocs(c)).state, 0)
    test.assert_eq(mcp2515.errors_or_idle(link(c)).rx, 200)

fn CanBusErrors0() -> embedded_hal.CanBusErrors
    embedded_hal.CanBusErrors { tx: -1, rx: -1, state: -1 }

@test
fn test_the_bit_rate_is_read_back_from_the_registers() [io]
    // Before open the registers are zero: no rate.
    let n = chip()
    test.assert_eq(mcp2515.bitrate_read(link(n), 16000000), 0)
    test.assert_eq(mcp2515.bitrate_read(link_nocs(n), 16000000), 0)
    // After open, every rate of the table makes the rate back.
    for osc in [8000000, 16000000]
        for rate in [5000, 10000, 20000, 31250, 33333, 40000, 50000, 80000, 100000, 125000, 200000, 250000, 500000, 1000000]
            if mcp2515.bit_timing_known(osc, rate) >= 0
                let c = chip()
                test.assert_eq(mcp2515.open_code(link(c), osc, rate, mcp2515.config_default()), 0)
                test.assert_eq(mcp2515.bitrate_read(link(c), osc), rate)
    // A solved rate.
    let s = chip()
    test.assert_eq(mcp2515.open_code(link(s), 12000000, 500000, mcp2515.config_default()), 0)
    test.assert_eq(mcp2515.bitrate_read(link(s), 12000000), 500000)

// ── Loopback, end to end ─────────────────────────────────────────────

@test
fn test_loopback_returns_the_frames_sent() [io]
    let c = chip()
    test.assert(mcp2515.open_simple(link(c), 16000000, 500000, 1))
    let l = link(c)
    test.assert_eq(mcp2515.send_frame(l, std_frame(0x123, 4, 0x04030201)), 0)
    test.assert_eq(mcp2515.send_frame(l, ext_frame(0x1ABCDEF0, 2, 0xBEEF)), 1)
    bus_run(c)
    let a = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert_eq(a.id, 0x123)
    test.assert_eq(a.data, 0x04030201)
    let b = mcp2515.receive_frame(l) ?? std_frame(0, 0, 0)
    test.assert_eq(b.id, 0x1ABCDEF0)
    test.assert(b.extended)
    test.assert_eq(b.data, 0xBEEF)
    test.assert(mcp2515.tx_idle(l))

@test
fn test_listen_only_sends_nothing() [io]
    let c = chip()
    let s = Mcp2515Config { mode: 3, one_shot: false, rollover: true, accept_all: true,
                            irq_mask: 0, clkout: 0, timing: -1 }
    test.assert_eq(mcp2515.open_code(link(c), 16000000, 500000, s), 0)
    test.assert_eq(mcp2515.send_frame(link(c), std_frame(0x1, 0, 0)), 0)
    bus_run(c)
    test.assert_eq(at(c.st, 40), 0)
    // It receives.
    inject(c, 0x456, false, false, 0, 0)
    test.assert_eq((mcp2515.receive_frame(link(c)) ?? std_frame(0, 0, 0)).id, 0x456)

// ── The part on a board ──────────────────────────────────────────────

@test
fn test_the_part_on_a_board_answers_as_absent_hardware() [io]
    // The host's board handles drive no hardware: every transfer is
    // refused or reads as an absent part, so each method answers as for a
    // part that is not there.
    let w = dev_bus.wiring_irq(dev_bus.wiring_spi(0, 5), 6)
    let m = Mcp2515.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, w, 16000000)
    test.assert(not m.open(500000, 0))
    test.assert_eq(m.open_with(500000, mcp2515.config_default()), -1)
    // The bus reads zeros, which is not Configuration mode, so a frame is
    // taken and nothing is pending, and nothing comes back.
    test.assert(m.send(std_frame(0x1, 0, 0)))
    test.assert_eq(m.send_priority(std_frame(0x1, 0, 0), 1), 0)
    test.assert(m.receive() == None)
    test.assert(m.receive_by_pin() == None)
    test.assert(m.tx_done())
    test.assert_eq(m.bitrate(), 0)
    test.assert_eq(m.errors().state, 0)
    test.assert_eq(m.mode() ?? -1, 0)
    test.assert(m.set_mode(0))
    test.assert_eq(m.flags() ?? -1, 0)
    test.assert(m.clear_flags(1))
    test.assert(m.int_level() >= 0)
    test.assert(m.abort_all())
    // The link over the handles.
    let lk = m.as_link()
    test.assert(lk.link_setup())
    lk.link_wait(1)
    test.assert(lk.link_irq() >= 0)
    var tx: DevBytes = Vec.new()
    var rx: DevBytes = Vec.new()
    test.assert(lk.link_xfer(tx, 0, var rx))
    // No INT pin and no chip select.
    let n = Mcp2515.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, dev_bus.wiring_i2c(0, 1), 8000000)
    let nl = n.as_link()
    test.assert(not nl.link_setup())
    test.assert_eq(nl.link_irq(), -1)

@test
fn test_the_part_is_a_canbus() [io]
    // The six methods of `CanBus` forward to the module's functions; on the
    // host's handles nothing answers, and they must not fail.
    let m = Mcp2515.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, dev_bus.wiring_spi(0, 5), 16000000)
    use_bus(m)

fn use_bus<B: CanBus>(b: B) [hw]
    let _ = b.open(500000, 1)
    let _ = b.send(std_frame(0x1, 0, 0))
    let _ = b.receive()
    let _ = b.tx_done()
    let _ = b.bitrate()
    let _ = b.errors()
